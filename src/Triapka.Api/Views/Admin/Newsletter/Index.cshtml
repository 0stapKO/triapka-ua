@model Triapka.Application.DTOs.SendNewsletterDto
@{
    Layout = null;
    var subscriberCount = (int)(ViewBag.SubscriberCount ?? 0);
}
<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TRIAPKA.UA — Адмін: Розсилка</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root{
            --bg: #ffffff;
            --panel: #f8f9fa;
            --panel-2: #e9ecef;
            --stroke: rgba(0,0,0,.08);
            --text: #212529;
            --muted: rgba(0,0,0,.5);
            --accent: #20c997;
            --mint: #20c997;
            --mint-2: #1aa179;
            --danger: #dc3545;
            --warning-bg: #fff3cd;
            --warning-border: #ffc107;
            --warning-text: #664d03;
            --shadow: 0 8px 30px rgba(0,0,0,.08);
            --r-xl: 32px;
            --r-lg: 26px;
            --r-md: 20px;
            --r-sm: 16px;
        }

        *{ box-sizing:border-box; }
        html, body{ height:100%; margin:0; }
        body{
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            font-size: 16px;
            background:
                radial-gradient(1100px 700px at 20% -10%, rgba(32,201,151,.10), transparent 60%),
                radial-gradient(900px 600px at 85% 0%, rgba(32,201,151,.06), transparent 55%),
                var(--bg);
            color: var(--text);
        }

        .shell{
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 24px 80px;
        }

        /* Header */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 36px;
            flex-wrap: wrap;
            gap: 16px;
        }
        .page-header h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .icon-style {
            stroke-width: 2.5px;
            color: var(--accent);
            display: inline-block;
        }

        /* Stat badge */
        .stat-badge {
            background: linear-gradient(135deg, var(--mint), var(--mint-2));
            color: white;
            border-radius: var(--r-md);
            padding: 16px 28px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 8px 24px rgba(32,201,151,.3);
        }
        .stat-badge .count {
            font-size: 42px;
            font-weight: 900;
            line-height: 1;
        }
        .stat-badge .label {
            font-size: 14px;
            opacity: .85;
            font-weight: 600;
        }

        /* Banners */
        .banner {
            border-radius: var(--r-sm);
            padding: 14px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            font-size: 15px;
            animation: fadeIn .3s ease;
        }
        .banner-success { background: #d1fae5; border: 1px solid #6ee7b7; color: #065f46; }
        .banner-warning { background: var(--warning-bg); border: 1px solid var(--warning-border); color: var(--warning-text); }
        .banner-error   { background: #fee2e2; border: 1px solid #fca5a5; color: #7f1d1d; }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Card */
        .card {
            background: var(--panel);
            border: 1px solid var(--stroke);
            border-radius: var(--r-xl);
            box-shadow: var(--shadow);
            padding: 36px;
        }
        .card h2 {
            margin: 0 0 24px;
            font-size: 22px;
            font-weight: 700;
        }

        /* Form */
        .form-group { margin-bottom: 24px; }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 15px;
        }
        .form-control {
            width: 100%;
            background: var(--bg);
            border: 1px solid var(--stroke);
            border-radius: var(--r-sm);
            padding: 12px 16px;
            font-size: 15px;
            color: var(--text);
            outline: none;
            transition: .2s;
            font-family: inherit;
        }
        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 4px rgba(32,201,151,.1);
        }
        textarea.form-control {
            resize: vertical;
            min-height: 220px;
            line-height: 1.6;
        }
        .field-hint {
            margin-top: 6px;
            font-size: 13px;
            color: var(--muted);
        }
        .field-error {
            margin-top: 6px;
            font-size: 13px;
            color: var(--danger);
            font-weight: 600;
        }

        /* Actions */
        .form-actions {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 10px;
            flex-wrap: wrap;
        }
        .btn-send {
            background: linear-gradient(135deg, var(--mint), var(--mint-2));
            color: white;
            border: none;
            border-radius: 999px;
            padding: 14px 32px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 16px rgba(32,201,151,.3);
        }
        .btn-send:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(32,201,151,.4);
        }
        .btn-send:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none;
        }
        .btn-preview {
            background: transparent;
            border: 2px solid var(--accent);
            color: var(--accent);
            border-radius: 999px;
            padding: 12px 24px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s;
        }
        .btn-preview:hover { background: rgba(32,201,151,.08); }

        /* Subscribers link */
        .subscribers-link {
            margin-top: 24px;
            font-size: 14px;
            color: var(--muted);
        }
        .subscribers-link a {
            color: var(--accent);
            font-weight: 600;
            text-decoration: none;
        }
        .subscribers-link a:hover { text-decoration: underline; }

        /* Preview modal */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 50;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .modal-overlay.open { display: flex; }
        .modal {
            background: white;
            border-radius: var(--r-xl);
            width: 100%;
            max-width: 700px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 24px 80px rgba(0,0,0,.2);
        }
        .modal-header {
            padding: 20px 28px;
            border-bottom: 1px solid var(--stroke);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 700;
            font-size: 18px;
        }
        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--muted);
            padding: 4px;
            border-radius: 8px;
            transition: .15s;
        }
        .modal-close:hover { background: var(--panel-2); color: var(--text); }
        .modal-body {
            padding: 24px 28px;
            overflow-y: auto;
            flex: 1;
        }
        iframe#previewFrame {
            width: 100%;
            min-height: 400px;
            border: 1px solid var(--stroke);
            border-radius: var(--r-sm);
        }

        /* Back link */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--muted);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 28px;
            transition: .15s;
        }
        .back-link:hover { color: var(--text); }
    </style>
</head>
<body>
    <div class="shell">
        <a href="/Products" class="back-link">
            <i data-lucide="arrow-left" style="width:16px;height:16px;"></i>
            На головну
        </a>

        <div class="page-header">
            <h1>
                <i data-lucide="mail" class="icon-style" style="width:34px;height:34px;"></i>
                Розсилка
            </h1>

            <div class="stat-badge">
                <i data-lucide="users" style="width:28px;height:28px;opacity:.85;"></i>
                <div>
                    <div class="count">@subscriberCount</div>
                    <div class="label">підписник@(subscriberCount == 1 ? "" : subscriberCount is >= 2 and <= 4 ? "и" : "ів")</div>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="banner banner-success" role="alert">
                <i data-lucide="check-circle" style="width:20px;height:20px;flex-shrink:0;"></i>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="banner banner-warning" role="alert">
                <i data-lucide="alert-triangle" style="width:20px;height:20px;flex-shrink:0;"></i>
                @TempData["WarningMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="banner banner-error" role="alert">
                <i data-lucide="x-circle" style="width:20px;height:20px;flex-shrink:0;"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="card">
            <h2>Нова розсилка</h2>

            <form asp-action="Send" asp-controller="Newsletter" asp-area="" method="post" id="newsletterForm">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="Subject">Тема листа</label>
                    <input type="text"
                           id="Subject"
                           name="Subject"
                           class="form-control"
                           value="@Model.Subject"
                           placeholder="Наприклад: Акція тижня — знижки до 40%!" />
                    @Html.ValidationMessage("Subject", "", new { @class = "field-error" })
                </div>

                <div class="form-group">
                    <label for="HtmlBody">Текст листа (HTML)</label>
                    <textarea id="HtmlBody"
                              name="HtmlBody"
                              class="form-control"
                              placeholder="<h2>Привіт!</h2><p>Ваш текст розсилки...</p>">@Model.HtmlBody</textarea>
                    <div class="field-hint">Підтримується HTML-розмітка. Лист буде надіслано як <code>text/html</code>.</div>
                    @Html.ValidationMessage("HtmlBody", "", new { @class = "field-error" })
                </div>

                <div class="form-actions">
                    <button type="submit"
                            id="btnSend"
                            class="btn-send"
                            @(subscriberCount == 0 ? "disabled" : "")
                            onclick="this.disabled=true; this.innerHTML='<i data-lucide=\'loader\' style=\'width:18px;height:18px;\'></i>&nbsp;Надсилання…'; this.form.submit();">
                        <i data-lucide="send" style="width:18px;height:18px;"></i>
                        Надіслати @(subscriberCount > 0 ? $"{subscriberCount} підписникам" : "(немає підписників)")
                    </button>

                    <button type="button" class="btn-preview" onclick="openPreview()">
                        Переглянути лист
                    </button>
                </div>
            </form>

            <div class="subscribers-link">
                Перевірити список підписників:
                <a href="/Admin/Newsletter/Subscribers" target="_blank">
                    GET /Admin/Newsletter/Subscribers
                </a>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal-overlay" id="previewModal" onclick="if(event.target===this) closePreview()">
        <div class="modal">
            <div class="modal-header">
                <span>Попередній перегляд листа</span>
                <button class="modal-close" onclick="closePreview()" aria-label="Закрити">
                    <i data-lucide="x" style="width:22px;height:22px;"></i>
                </button>
            </div>
            <div class="modal-body">
                <iframe id="previewFrame" title="Попередній перегляд"></iframe>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();

        function openPreview() {
            const body = document.getElementById('HtmlBody').value;
            const frame = document.getElementById('previewFrame');
            const modal = document.getElementById('previewModal');

            frame.srcdoc = body || '<p style="color:#888;font-style:italic;">Введіть HTML у поле вище</p>';
            modal.classList.add('open');
            lucide.createIcons();
        }

        function closePreview() {
            document.getElementById('previewModal').classList.remove('open');
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closePreview();
        });
    </script>
</body>
</html>
