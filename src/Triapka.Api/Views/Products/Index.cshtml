@model IEnumerable<Triapka.Application.DTOs.ProductListDto>
@{
    Layout = null;
}

<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Каталог</title>
    <style>
        :root{
            --bg: #121212;
            --panel: #1e1e1e;
            --panel-2: #252525;
            --stroke: rgba(255,255,255,.08);
            --text: rgba(255,255,255,.92);
            --muted: rgba(255,255,255,.68);
            --subtle: rgba(255,255,255,.52);
            --mint: #97e6c2;
            --mint-2: #6fd7ab;
            --shadow: 0 18px 60px rgba(0,0,0,.45);
            --r-lg: 22px;
            --r-md: 16px;
        }

        *{ box-sizing:border-box; }
        html, body{ height:100%; }
        body{
            margin:0;
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, "Noto Sans", "Helvetica Neue", sans-serif;
            background:
                radial-gradient(900px 500px at 20% -10%, rgba(151,230,194,.10), transparent 60%),
                radial-gradient(700px 450px at 85% 0%, rgba(151,230,194,.06), transparent 55%),
                var(--bg);
            color: var(--text);
            overflow-x:hidden;
        }

        /* clean scrollbars */
        body::-webkit-scrollbar{ width:10px; height:10px; }
        body::-webkit-scrollbar-thumb{ background: rgba(255,255,255,.10); border-radius: 999px; }
        body::-webkit-scrollbar-track{ background: transparent; }
        *{ scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.14) transparent; }

        .wrap{
            max-width: 1160px;
            margin: 0 auto;
            padding: 28px 18px 54px;
        }

        .topbar{
            display:flex;
            gap:14px;
            align-items:flex-end;
            justify-content:space-between;
            margin-bottom: 18px;
        }

        .title{
            letter-spacing: .2px;
            font-weight: 650;
            margin: 0;
            font-size: 22px;
            line-height: 1.2;
        }
        .subtitle{
            margin: 6px 0 0;
            color: var(--muted);
            font-size: 13px;
        }

        .search-form{
            flex: 1;
            display:flex;
            gap:10px;
            align-items:center;
            justify-content:flex-end;
            min-width: 320px;
        }
        .search-form input{
            width: min(520px, 100%);
            padding: 12px 14px;
            border-radius: 999px;
            border: 1px solid var(--stroke);
            background: rgba(255,255,255,.04);
            color: var(--text);
            outline: none;
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }
        .search-form input::placeholder{ color: rgba(255,255,255,.40); }
        .search-form input:focus{
            border-color: rgba(151,230,194,.55);
            box-shadow: 0 0 0 5px rgba(151,230,194,.12);
            background: rgba(255,255,255,.05);
        }

        .btn{
            appearance:none;
            border: 0;
            border-radius: 999px;
            padding: 12px 16px;
            font-weight: 650;
            letter-spacing: .2px;
            cursor:pointer;
            transition: transform .12s ease, filter .12s ease, background .12s ease, color .12s ease, border-color .12s ease;
            user-select:none;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            gap: 8px;
            white-space:nowrap;
        }
        .btn:active{ transform: translateY(1px); }

        .btn-primary{
            background: linear-gradient(180deg, var(--mint), var(--mint-2));
            color: rgba(0,0,0,.82);
            box-shadow: 0 12px 30px rgba(151,230,194,.16);
        }
        .btn-primary:hover{ filter: brightness(1.03); }

        .search-form button{
            background: linear-gradient(180deg, var(--mint), var(--mint-2));
            color: rgba(0,0,0,.82);
            box-shadow: 0 12px 30px rgba(151,230,194,.16);
        }
        .search-form button:hover{ filter: brightness(1.03); }

        .grid{
            margin-top: 18px;
            display:grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 14px;
        }

        .card{
            grid-column: span 3;
            background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03));
            border: 1px solid var(--stroke);
            border-radius: var(--r-lg);
            overflow:hidden;
            box-shadow: var(--shadow);
            min-height: 320px;
            display:flex;
            flex-direction:column;
        }

        .media{
            height: 168px;
            background: radial-gradient(460px 240px at 35% 15%, rgba(151,230,194,.18), transparent 55%),
                        linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
            border-bottom: 1px solid var(--stroke);
            position:relative;
        }
        .media img{
            position:absolute;
            inset:0;
            width:100%;
            height:100%;
            object-fit: cover;
            opacity: .95;
            filter: saturate(.95) contrast(1.02);
        }
        .media .ph{
            position:absolute;
            inset:0;
            display:flex;
            align-items:center;
            justify-content:center;
            color: rgba(255,255,255,.35);
            font-weight: 600;
            letter-spacing: .3px;
            text-transform: uppercase;
            font-size: 11px;
        }

        .content{
            padding: 14px 14px 12px;
            display:flex;
            flex-direction:column;
            gap: 10px;
            flex: 1;
        }

        .name{
            margin:0;
            font-size: 14px;
            line-height: 1.25;
            letter-spacing: .15px;
            font-weight: 650;
            color: var(--text);
            display:-webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow:hidden;
            min-height: 36px;
        }

        .meta{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap: 10px;
            margin-top: auto;
        }
        .price{
            font-weight: 750;
            letter-spacing: .2px;
            color: rgba(255,255,255,.92);
        }
        .price small{
            color: var(--subtle);
            font-weight: 650;
            margin-left: 4px;
            letter-spacing: .2px;
        }

        .btn-ghost{
            background: rgba(255,255,255,.04);
            color: rgba(255,255,255,.86);
            border: 1px solid var(--stroke);
            padding: 10px 12px;
        }
        .btn-ghost:hover{
            background: rgba(255,255,255,.06);
            border-color: rgba(151,230,194,.30);
        }

        .empty{
            margin-top: 18px;
            padding: 22px 18px;
            border-radius: var(--r-lg);
            background: rgba(255,255,255,.03);
            border: 1px solid var(--stroke);
            color: var(--muted);
        }

        @@media (max-width: 1100px){
            .card{ grid-column: span 4; }
        }
        @@media (max-width: 780px){
            .topbar{ flex-direction:column; align-items:stretch; }
            .search-form{ justify-content:stretch; min-width: unset; }
            .search-form input{ width: 100%; }
            .card{ grid-column: span 6; }
        }
        @@media (max-width: 520px){
            .card{ grid-column: span 12; }
        }
    </style>
</head>
<body>
    <main class="wrap">
        <div class="topbar">
            <div>
                <h1 class="title">Каталог</h1>
                <p class="subtitle">Мінімалістичний преміум‑інтерфейс у темній темі.</p>
            </div>

            <form asp-controller="Products" asp-action="Index" method="get" class="search-form">
                <input type="text" name="search" placeholder="Пошук товарів..." />
                <button type="submit">Шукати</button>
            </form>
        </div>

        @if (Model is null || !Model.Any())
        {
            <div class="empty">Нічого не знайдено. Спробуйте змінити запит.</div>
        }
        else
        {
            <section class="grid" aria-label="Products">
                @foreach (var p in Model)
                {
                    <article class="card">
                        <div class="media">
                            @if (!string.IsNullOrWhiteSpace(p.MainImageUrl))
                            {
                                <img src="@p.MainImageUrl" alt="@p.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="ph">Image</div>
                            }
                        </div>

                        <div class="content">
                            <h3 class="name">@p.Name</h3>

                            <div class="meta">
                                <div class="price">
                                    @p.Price.ToString("0.00") <small>₴</small>
                                </div>
                                <a class="btn btn-ghost"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@p.ProductId">
                                    Details
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
    </main>
</body>
</html>
