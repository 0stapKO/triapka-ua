@model Triapka.Application.DTOs.ProductDetailsDto
@{
    Layout = null;
    var m = Model!;
    var hero = m.ImageUrls?.FirstOrDefault(u => !string.IsNullOrWhiteSpace(u));
}

<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(Model?.Name ?? "Details")</title>
    <style>
        :root{
            --bg: #121212;
            --panel: #1e1e1e;
            --panel-2: #252525;
            --stroke: rgba(255,255,255,.08);
            --text: rgba(255,255,255,.92);
            --muted: rgba(255,255,255,.68);
            --subtle: rgba(255,255,255,.50);
            --mint: #97e6c2;
            --mint-2: #6fd7ab;
            --shadow: 0 18px 60px rgba(0,0,0,.45);
            --r-lg: 24px;
            --r-md: 16px;
        }

        *{ box-sizing:border-box; }
        html, body{ height:100%; }
        body{
            margin:0;
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, "Noto Sans", "Helvetica Neue", sans-serif;
            background:
                radial-gradient(900px 500px at 20% -10%, rgba(151,230,194,.10), transparent 60%),
                radial-gradient(700px 450px at 85% 0%, rgba(151,230,194,.06), transparent 55%),
                var(--bg);
            color: var(--text);
            overflow-x:hidden;
        }

        /* clean scrollbars */
        body::-webkit-scrollbar{ width:10px; height:10px; }
        body::-webkit-scrollbar-thumb{ background: rgba(255,255,255,.10); border-radius: 999px; }
        body::-webkit-scrollbar-track{ background: transparent; }
        *{ scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.14) transparent; }

        .wrap{
            max-width: 1160px;
            margin: 0 auto;
            padding: 28px 18px 54px;
        }

        .nav{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .back{
            display:inline-flex;
            align-items:center;
            gap: 10px;
            color: rgba(255,255,255,.82);
            text-decoration:none;
            border: 1px solid var(--stroke);
            background: rgba(255,255,255,.03);
            padding: 10px 12px;
            border-radius: 999px;
            transition: background .12s ease, border-color .12s ease, transform .12s ease;
            user-select:none;
        }
        .back:hover{
            background: rgba(255,255,255,.05);
            border-color: rgba(151,230,194,.28);
        }
        .back:active{ transform: translateY(1px); }

        .panel{
            border-radius: var(--r-lg);
            background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03));
            border: 1px solid var(--stroke);
            box-shadow: var(--shadow);
            overflow:hidden;
        }

        .split{
            display:grid;
            grid-template-columns: 1.2fr .8fr;
            min-height: 520px;
        }

        .media{
            position:relative;
            background:
                radial-gradient(520px 320px at 35% 18%, rgba(151,230,194,.18), transparent 60%),
                linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
        }

        .media img{
            position:absolute;
            inset:0;
            width:100%;
            height:100%;
            object-fit: cover;
            opacity: .95;
            filter: saturate(.95) contrast(1.02);
        }

        .media .ph{
            position:absolute;
            inset:0;
            display:flex;
            align-items:center;
            justify-content:center;
            color: rgba(255,255,255,.35);
            font-weight: 650;
            letter-spacing: .35px;
            text-transform: uppercase;
            font-size: 12px;
        }

        .info{
            padding: 20px 20px 18px;
            display:flex;
            flex-direction:column;
            gap: 12px;
            border-left: 1px solid var(--stroke);
            background: rgba(0,0,0,.08);
        }

        .kicker{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap: 12px;
            color: var(--muted);
            font-size: 12px;
            letter-spacing: .2px;
        }

        .name{
            margin: 0;
            font-size: 26px;
            line-height: 1.15;
            letter-spacing: .2px;
            font-weight: 720;
        }

        .price{
            font-size: 18px;
            font-weight: 760;
            letter-spacing: .2px;
        }
        .price small{
            color: var(--subtle);
            font-weight: 650;
            margin-left: 6px;
        }

        .desc{
            margin: 6px 0 0;
            color: rgba(255,255,255,.76);
            line-height: 1.6;
            font-size: 14px;
            white-space: pre-wrap;
        }

        .actions{
            margin-top:auto;
            display:flex;
            gap: 10px;
            flex-wrap:wrap;
        }

        .btn{
            appearance:none;
            border: 0;
            border-radius: 999px;
            padding: 12px 14px;
            font-weight: 700;
            letter-spacing: .2px;
            cursor:pointer;
            transition: transform .12s ease, filter .12s ease, background .12s ease, color .12s ease, border-color .12s ease;
            user-select:none;
            text-decoration:none;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            gap: 8px;
            white-space:nowrap;
            flex: 1;
            min-width: 160px;
        }
        .btn:active{ transform: translateY(1px); }

        .btn-primary{
            background: linear-gradient(180deg, var(--mint), var(--mint-2));
            color: rgba(0,0,0,.82);
            box-shadow: 0 12px 30px rgba(151,230,194,.16);
        }
        .btn-primary:hover{ filter: brightness(1.03); }

        .btn-outline{
            background: rgba(255,255,255,.03);
            color: rgba(255,255,255,.88);
            border: 1px solid rgba(151,230,194,.30);
        }
        .btn-outline:hover{
            background: rgba(151,230,194,.10);
            border-color: rgba(151,230,194,.45);
        }

        .hint{
            margin-top: 10px;
            color: var(--muted);
            font-size: 12px;
        }

        @@media (max-width: 980px){
            .split{ grid-template-columns: 1fr; }
            .info{ border-left: 0; border-top: 1px solid var(--stroke); }
            .btn{ min-width: 0; }
        }
    </style>
</head>
<body>
    <main class="wrap">
        <div class="nav">
            <a class="back" asp-controller="Products" asp-action="Index">← Назад до каталогу</a>
        </div>

        <section class="panel">
            <div class="split">
                <div class="media" aria-label="Product image">
                    @if (!string.IsNullOrWhiteSpace(hero))
                    {
                        <img src="@hero" alt="@m.Name" />
                    }
                    else
                    {
                        <div class="ph">Image</div>
                    }
                </div>

                <div class="info">
                    <div class="kicker">
                        <span>@(string.IsNullOrWhiteSpace(m.CategoryName) ? "Категорія" : m.CategoryName)</span>
                        <span>@(m.Rating is null ? "—" : $"{m.Rating:0.0} ★")</span>
                    </div>

                    <h1 class="name">@m.Name</h1>

                    <div class="price">
                        @m.Price.ToString("0.00") <small>₴</small>
                    </div>

                    <p class="desc">
                        @(string.IsNullOrWhiteSpace(m.Description)
                            ? "Опис буде додано пізніше."
                            : m.Description)
                    </p>

                    <div class="actions">
                        <form asp-controller="Cart" asp-action="Add" method="post" style="flex:1; min-width: 160px;">
                            <input type="hidden" name="productId" value="@m.ProductId" />
                            <button type="submit" class="btn btn-primary">Add to Cart</button>
                        </form>

                        <form asp-controller="Wishlist" asp-action="Add" method="post" style="flex:1; min-width: 160px;">
                            <input type="hidden" name="productId" value="@m.ProductId" />
                            <button type="submit" class="btn btn-outline">Add to Wishlist</button>
                        </form>
                    </div>

                    <div class="hint">Після додавання буде редірект у відповідний список.</div>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
